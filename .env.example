# Copy to .env and fill in.

# ---------------------------------------------------------------------------
# Provider: "gemini" or "ollama".
# ---------------------------------------------------------------------------
LLM_PROVIDER=gemini

# --- Gemini ----------------------------------------------------------------
# Gemini speaks OpenAI's chat-completions format at the /v1beta/openai path, so
# LangChain's ChatOpenAI drives it unchanged - only base_url and the key differ.
# Get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=AQ...
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-3.6-flash

# --- Ollama ----------------------------------------------------------------
# Set LLM_PROVIDER=ollama to run everything locally. No API key needed.
# Tags ending in "-cloud" run on Ollama's hosted infra and require a one-time
# `ollama signin`; nothing is downloaded. Drop the suffix for a local model
# you pulled yourself (e.g. `ollama pull llama3.1` -> OLLAMA_MODEL=llama3.1).
# NOTE: the classifier node uses structured output, which needs tool-calling.
# Small local models are often unreliable at it; the cloud tags are not.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gpt-oss:20b-cloud
OLLAMA_NUM_CTX=8192

# ---------------------------------------------------------------------------
# LangSmith tracing (optional but the point of the exercise).
# These are the CURRENT env var names - the older LANGCHAIN_* spellings still
# work but are deprecated. With tracing on, every graph run appears in the
# LangSmith UI broken down per node, with tool inputs/outputs and latency.
# Get a key at https://smith.langchain.com
# ---------------------------------------------------------------------------
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_pt_...
LANGSMITH_PROJECT=telecom-response-prototype
# Only needed for EU / self-hosted LangSmith:
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
