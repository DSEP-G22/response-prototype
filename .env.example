# ---------------------------------------------------------------------------
# LLM provider. Set LLM_PROVIDER to "anthropic" or "openai" and fill in the
# matching key. LLM_MODEL is optional - omit it to use the per-provider default
# (claude-sonnet-4-5 / gpt-4o-mini).
# ---------------------------------------------------------------------------
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# LLM_MODEL=claude-sonnet-4-5

# ---------------------------------------------------------------------------
# LangSmith tracing. These are the CURRENT env var names (the older LANGCHAIN_*
# spellings still work but are deprecated). With tracing on, every graph run
# appears in the LangSmith UI broken down per node, with tool inputs/outputs
# and latency.
# ---------------------------------------------------------------------------
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_pt_...
LANGSMITH_PROJECT=telecom-response-prototype
# Only needed for EU / self-hosted LangSmith:
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
